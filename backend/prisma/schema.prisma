datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────
// AUTH & USERS
// Created by: Hamza Baker
// Created at: 31.03.2026
// ─────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  // Only the bcrypt hash is stored, never the raw password.
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true)  @map("is_active")
  isVerified   Boolean   @default(false) @map("is_verified")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt      @map("updated_at") @db.Timestamptz

  profile         UserProfile?
  addresses       UserAddress[]
  userRoles       UserRole[]
  // Refresh tokens are stored hashed for security.
  refreshTokens   RefreshToken[]
  cart            Cart?
  orders          Order[]
  ownedBrands     Brand[]
  brandFollowers  BrandFollower[]
  @@map("users")
}

model UserProfile {
  // userId is the PK — no separate id needed for a strict one-to-one relation.
  userId    String    @id @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name")  @db.VarChar(100)
  avatarUrl String?   @map("avatar_url")
  birthDate DateTime? @map("birth_date") @db.Date
  gender    String?   @db.VarChar(20)

  // Cosmetics-specific fields for personalized product recommendations.
  skinType  String?   @map("skin_type") @db.VarChar(50)
  skinTone  String?   @map("skin_tone") @db.VarChar(50)
  hairType  String?   @map("hair_type") @db.VarChar(50)

  bio       String?

  @@map("user_profiles")
}

model UserAddress {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(100)
  fullName    String  @map("full_name")    @db.VarChar(200)
  phone       String  @db.VarChar(20)
  country     String  @db.VarChar(100)
  city        String  @db.VarChar(100)
  district    String? @db.VarChar(100)
  postalCode  String? @map("postal_code")  @db.VarChar(20)
  addressLine String  @map("address_line")
  // Only one address can be default per user.
  isDefault   Boolean @default(false) @map("is_default")

  @@map("user_addresses")
}

model Role {
  id          Int      @id @default(autoincrement()) @db.SmallInt
  name        String   @unique @db.VarChar(50)
  description String?

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     Int       @map("role_id") @db.SmallInt
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Token is stored as a hash, never as plain text.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  isRevoked  Boolean   @default(false) @map("is_revoked")
  // Stores browser/device info for security audit purposes.
  deviceInfo Json?     @map("device_info")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// BRANDS
// Created by: Hamza Baker
// Created at: 31.03.2026
// ─────────────────────────────────────────

model Brand {
  id              String   @id @default(uuid())
  ownerUserId     String   @map("owner_user_id")
  // Every brand must have an owner user account.
  owner           User     @relation(fields: [ownerUserId], references: [id])

  slug            String   @unique @db.VarChar(150)
  name            String   @db.VarChar(200)
  logoUrl         String?  @map("logo_url")
  coverUrl        String?  @map("cover_url")
  description     String?
  websiteUrl      String?  @map("website_url")
  countryOfOrigin String?  @map("country_of_origin") @db.VarChar(100)
  foundedYear     Int?     @map("founded_year") @db.SmallInt
  isVerified      Boolean  @default(false) @map("is_verified")
  isActive        Boolean  @default(true)  @map("is_active")
  // Calculated and cached from reviews to avoid expensive aggregation queries.
  ratingAvg       Decimal? @map("rating_avg") @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  products        Product[]
  followers       BrandFollower[]
  documents       BrandDocument[]

  @@map("brands")
}

model BrandFollower {
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId    String    @map("brand_id")
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  followedAt DateTime? @map("followed_at") @db.Timestamptz

  @@id([userId, brandId])
  @@map("brand_followers")
}

model BrandDocument {
  id         String    @id @default(uuid())
  brandId    String    @map("brand_id")
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  docType    String    @map("doc_type")    @db.VarChar(100)
  fileUrl    String    @map("file_url")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy String?   @map("verified_by")
  // Document goes through pending → approved/rejected flow.
  status     String    @default("pending") @db.VarChar(30)
  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz

  @@map("brand_documents")
}

// ─────────────────────────────────────────
// PRODUCT CATALOGUE
// Created by: Hamza Baker
// Created at: 31.03.2026
// ─────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  // Self-relation: a category can have a parent category (e.g. Makyaj → Ruj).
  parentId  String?   @map("parent_id")
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  slug      String   @unique @db.VarChar(150)
  name      String   @db.VarChar(150)
  iconUrl   String?  @map("icon_url")
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  isActive  Boolean  @default(true) @map("is_active")
  // Level 1 = Ana kategori, Level 2 = Alt kategori
  level     Int      @db.SmallInt

  products        Product[]
  attributeGroups AttributeGroup[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  brandId     String   @map("brand_id")
  brand       Brand    @relation(fields: [brandId], references: [id])
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])

  slug        String   @unique @db.VarChar(255)
  name        String   @db.VarChar(300)
  barcode     String?  @unique @db.VarChar(50)
  description String?
  ingredients String?
  howToUse    String?  @map("how_to_use")
  // Base price in original currency, variants can override this.
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  currency    String   @default("TRY") @db.Char(3)
  isActive    Boolean  @default(true)  @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  // Cached from reviews to avoid expensive aggregation on every request.
  ratingAvg   Decimal? @map("rating_avg")   @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  variants    ProductVariant[]
  images      ProductImage[]
  attributes  ProductAttribute[]
  tags        ProductTag[]

  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku           String   @unique @db.VarChar(100)
  shadeName     String?  @map("shade_name") @db.VarChar(100)
  // Hex color code for shade preview (e.g. #FF5733).
  shadeHex      String?  @map("shade_hex")  @db.Char(7)
  sizeLabel     String?  @map("size_label") @db.VarChar(50)
  weightGrams   Decimal? @map("weight_grams") @db.Decimal(8, 2)
  // If set, overrides the parent product's base price for this variant.
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0)    @map("sort_order") @db.SmallInt

  inventory     Inventory?

  images  ProductImage[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")

}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String? @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  url       String
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0)     @map("sort_order") @db.SmallInt
  // Only one image can be primary per product.
  isPrimary Boolean @default(false) @map("is_primary")

  @@map("product_images")
}

model AttributeGroup {
  id           String    @id @default(uuid())
  categoryId   String?   @map("category_id")
  category     Category? @relation(fields: [categoryId], references: [id])

  name         String   @db.VarChar(150)
  slug         String   @db.VarChar(150)
  // Marks this group as usable in the filter sidebar.
  isFilterable Boolean  @default(true) @map("is_filterable")
  sortOrder    Int      @default(0)    @map("sort_order") @db.SmallInt

  values       AttributeValue[]

  @@map("attribute_groups")
}

model AttributeValue {
  id        String         @id @default(uuid())
  groupId   String         @map("group_id")
  group     AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  value     String  @db.VarChar(150)
  sortOrder Int?    @map("sort_order") @db.SmallInt

  products  ProductAttribute[]

  @@map("attribute_values")
}

model ProductAttribute {
  productId        String         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String         @map("attribute_value_id")
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@map("product_attributes")
}

model Tag {
  id       String       @id @default(uuid())
  slug     String       @unique @db.VarChar(100)
  name     String       @db.VarChar(100)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model Inventory {
  id                String         @id @default(uuid())
  variantId         String         @unique @map("variant_id")
  // Inventory is tracked per variant, not per product.
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity          Int @default(0)
  // Reserved quantity for pending orders — not available for new purchases.
  reservedQty       Int @default(0) @map("reserved_qty")
  // Alert is triggered when quantity drops below this threshold.
  lowStockThreshold Int @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("inventory")
}

// ─────────────────────────────────────────
// CART & CART ITEMS
// Created by: Hamza Baker
// Created at: 03.05.2026
// ─────────────────────────────────────────

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id")
  // One cart per user — enforced by @unique on userId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int            @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @map("variant_id")
  // variantId is String (UUID) — matches product_variants.id convention
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // A variant can only appear once per cart
  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ─────────────────────────────────────────
// ORDERS & ORDER ITEMS
// Created by: Hamza Baker
// Created at: 05.05.2026
// ─────────────────────────────────────────

model Order {
  id               Int      @id @default(autoincrement())
  userId           String   @map("user_id")
  // Restrict prevents deleting a user who has order history — financial records must be preserved
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Human-readable order number for customer-facing display (e.g. ORD-00001)
  orderNumber      String   @unique @map("order_number") @db.VarChar(30)
  // Allowed values: PENDING, PAID, CANCELLED, REFUNDED
  status           String   @default("PENDING") @db.VarChar(50)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(12, 2)
  currency         String   @default("TRY") @db.Char(3)
  // Stores mock payment ID now, real Stripe payment intent ID later
  paymentReference String?  @map("payment_reference") @db.VarChar(255)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt      @map("updated_at") @db.Timestamptz

  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int            @id @default(autoincrement())
  orderId     Int            @map("order_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String         @map("variant_id")
  // variantId is String (UUID) — matches product_variants.id convention
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  // Snapshot of product name and SKU at time of purchase — protects against future changes
  productName String   @map("product_name") @db.VarChar(300)
  sku         String   @db.VarChar(100)
  quantity    Int      @db.SmallInt
  // Price snapshot at time of purchase — never reference live price
  unitPrice   Decimal  @map("unit_price")  @db.Decimal(10, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("order_items")
}